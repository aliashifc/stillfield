---
import Base from '../layouts/Base.astro';
import Modal from '../components/Modal';
import Ambience from '../components/Ambience';
import Dome from '../components/Dome';
import '../styles/global.css';
import '../styles/modal.css';
import '../styles/ambience.css';
---
<Base>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/tenor-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/quicksand-400.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

  <h1 class="sr-only">Stillfield — non-sensory calm pods for spas, hotels &amp; workplaces</h1>

  <main class="stage">
    <!-- The rotunda (WebGL) — decorative; all real content is in the HTML below.
         Before hydration / without JS, a CSS approximation of the light pool shows. -->
    <Dome client:load />

    <header class="topbar">
      <a href="/" class="brand" aria-label="Stillfield home">
        <span class="wordmark">STILLFIELD</span>
      </a>
      <button class="sound-toggle" data-sound type="button" aria-label="Toggle ambient sound" aria-pressed="false" hidden>
        <svg class="snd snd-off" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 6.5L18 12l-9 5.5V6.5z" fill="currentColor"/>
        </svg>
        <svg class="snd snd-on" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="8.4" y="6.8" width="2.7" height="10.4" rx="1.2" fill="currentColor"/>
          <rect x="12.9" y="6.8" width="2.7" height="10.4" rx="1.2" fill="currentColor"/>
        </svg>
      </button>
    </header>

    <!-- CTA standing in the pool of light beneath the oculus -->
    <div class="floor-cta">
      <button class="register" data-cta aria-haspopup="dialog">Register Interest</button>
    </div>

    <!-- captions on the horizon, flanking the lamp -->
    <div class="lower">
      <div class="caption">
        <h2 class="lede">A space where the noise ends.</h2>
      </div>
      <div class="caption caption-right">
        <p class="body-copy">Non-sensory pods that deliver deep calm in 15&ndash;30 minutes. Designed for spas, wellness centres, hotels, and forward-thinking workplaces.</p>
      </div>
    </div>
  </main>

  <Modal client:idle />
  <Ambience client:load />
</Base>
